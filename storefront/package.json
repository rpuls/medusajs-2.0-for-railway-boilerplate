{
  "name": "medusa-next",
  "version": "1.0.3",
  "private": true,
  "author": "Kasper Fabricius Kristensen <kasper@medusajs.com> & Victor Gerbrands <victor@medusajs.com> (https://www.medusajs.com)",
  "description": "Next.js Starter to be used with Medusa server",
  "keywords": [
    "medusa-storefront"
  ],
  "scripts": {
    "wait": "await-backend",
    "launcher": "launch-storefront",
    "dev": "npm run wait && npm run launcher dev",
    "build": "npm run wait && npm run launcher build",
    "start": "npm run launcher start",
    "build:next": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "test-e2e": "playwright test e2e",
    "test:qa": "playwright test --config=playwright.qa.config.ts",
    "test:qa:ui": "playwright test --config=playwright.qa.config.ts --ui",
    "test:qa:watch": "playwright test --config=playwright.qa.config.ts --headed"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@medusajs/icons": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/types": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@meilisearch/instant-meilisearch": "^0.31.2",
    "@paypal/paypal-js": "^5.0.6",
    "@paypal/react-paypal-js": "^7.8.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "lodash": "^4.18.1",
    "medusajs-launch-utils": "0.1.0",
    "meilisearch": "^0.57.0",
    "next": "^15.5.15",
    "react": "19.2.8",
    "react-country-flag": "^3.0.2",
    "react-dom": "19.2.8",
    "react-instantsearch": "^7.46.0",
    "server-only": "^0.0.1",
    "tailwindcss-radix": "^2.8.0"
  },
  "devDependencies": {
    "@medusajs/ui-preset": "2.19.0",
    "@playwright/test": "^1.62.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.5.4",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.15",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
