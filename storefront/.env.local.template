# Your Medusa backend, should be updated to where you are hosting your server. Remember to update CORS settings for your server.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Required. The storefront refuses to start without it (see check-env-variables.js).
# Create one in Medusa Admin under Settings > Publishable API Keys, or let
# `pnpm ib` generate and share it automatically.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Your store URL, should be updated to where you are hosting your storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Your store's name. Shown in the nav, footer, checkout header, page titles and
# the checkout legal copy. Defaults to "Your Store" if unset.
NEXT_PUBLIC_STORE_NAME=

# Your preferred default region, used when the visitor's region cannot be
# determined from the request IP. It must be a country covered by one of your
# regions in Medusa. The seed script creates a single "Europe" region covering
# gb, de, dk, se, fr, es and it, so "gb" is correct for a freshly seeded store.
# If you add a region, update this to match.
NEXT_PUBLIC_DEFAULT_REGION=gb

# Hostname that product images are served from (optional).
# Set this to the host of your S3-compatible storage, e.g. my-bucket.storage.railway.app
# or localhost:9004 when using the local docker-compose MinIO service.
# NEXT_PUBLIC_MEDIA_HOSTNAME=your-bucket-hostname
# Legacy alias, still supported:
# NEXT_PUBLIC_MINIO_ENDPOINT=bucket-production-eaeb.up.railway.app

# Search needs no settings here. The storefront searches through the backend's
# POST /store/search, which works whenever the backend has MeiliSearch
# configured. NEXT_PUBLIC_SEARCH_ENDPOINT, NEXT_PUBLIC_SEARCH_API_KEY and
# NEXT_PUBLIC_INDEX_NAME from older versions are no longer read and can be
# removed.

# Search is shown by default. Set this to exactly "true" to hide the search
# link in the main navigation. Note that link is the only route into search in
# the UI, so hiding it makes search unreachable for shoppers even though
# /search and /results still respond.
# NEXT_PUBLIC_FEATURE_SEARCH_DISABLED=true

# Google site verification (optional). The code from the "HTML tag" method in
# Google Merchant Center or Search Console, without the surrounding tag. It is
# rendered as <meta name="google-site-verification"> on every page, which proves
# the site is yours without a DNS record (a Railway subdomain has none to edit).
# GOOGLE_SITE_VERIFICATION=

# Payments (optional). Without a Stripe publishable key the card payment step
# shows a configuration message instead of a payment form.
# NEXT_PUBLIC_STRIPE_KEY=pk_test_...

# PayPal. The storefront half is complete (button, icon, payment wrapper), but
# this variable alone does nothing: the button only renders for a payment
# session whose provider id starts with "pp_paypal", and this template
# registers no PayPal provider in backend/medusa-config.js. To switch PayPal
# on you install and register a PayPal payment provider on the backend first,
# and then set this. No storefront change is needed at that point.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
