{
  "name": "medusa-2.0-boilerplate-backend",
  "version": "0.0.2",
  "description": "A Prebaked Medusa 2.0 backend",
  "author": "Rasmus Puls",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build && node src/scripts/postBuild.js",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "ib": "init-backend",
    "start": "init-backend && cd .medusa/server && medusa start --verbose",
    "dev": "medusa develop",
    "email:dev": "email dev --dir=./src/modules/email-notifications/templates --port=3002"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/notification-sendgrid": "2.19.0",
    "@medusajs/payment-stripe": "2.19.0",
    "@medusajs/workflow-engine-redis": "2.19.0",
    "@react-email/components": "^1.0.1",
    "@rokmohar/medusa-plugin-meilisearch": "2.0.0",
    "medusajs-launch-utils": "0.0.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "6.25.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.19.0",
    "@react-email/preview-server": "^5.1.0",
    "@swc/core": "1.16.1",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "react-email": "^5.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.5.8",
      "protobufjs": "7.5.5"
    }
  },
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22.12",
    "npm": "10.x"
  }
}
